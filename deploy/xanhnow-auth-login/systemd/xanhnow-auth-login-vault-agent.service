[Unit]
Description=XanhNow Auth Login Vault Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xanhnow
Group=xanhnow
ExecStart=/usr/local/bin/vault agent -config=/etc/xanhnow/s101/auth-login/vault-agent.hcl
Restart=always
RestartSec=5
SyslogIdentifier=xanhnow-auth-login-vault-agent
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
