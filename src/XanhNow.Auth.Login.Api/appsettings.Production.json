{
  "Infrastructure": {
    "Mode": "RedisVault"
  },
  "Vault": {
    "Address": "https://192.168.2.81:8200",
    "AuthMethod": "approle",
    "MountPath": "kv",
    "BasePath": "xanhnow/s101/auth-login",
    "RoleIdEnvironmentVariable": "XANHNOW_AUTH_LOGIN_VAULT_ROLE_ID",
    "SecretIdEnvironmentVariable": "XANHNOW_AUTH_LOGIN_VAULT_SECRET_ID",
    "RoleIdFile": "/etc/xanhnow/s101/auth-login/vault/role_id",
    "SecretIdFile": "/etc/xanhnow/s101/auth-login/vault/secret_id",
    "CaCertFile": "/etc/xanhnow/s101/auth-login/trust/vault-ca.crt"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
