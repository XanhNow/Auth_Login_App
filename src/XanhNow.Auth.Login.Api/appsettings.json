{
  "Infrastructure": {
    "Mode": "RedisVault"
  },
  "ConnectionStrings": {
    "AuthRuntimeTemplate": "Host=192.168.2.80;Port=5432;Database=authtest;Username=s101_xanhnow_auth_login_runtime;Pooling=true;No Reset On Close=true;Timeout=15;Command Timeout=30"
  },
  "Vault": {
    "Address": "https://192.168.2.81:8200",
    "AuthMethod": "approle",
    "MountPath": "kv",
    "BasePath": "xanhnow/s101/auth-login",
    "RoleIdEnvironmentVariable": "XANHNOW_AUTH_LOGIN_VAULT_ROLE_ID",
    "SecretIdEnvironmentVariable": "XANHNOW_AUTH_LOGIN_VAULT_SECRET_ID"
  },
  "Redis": {
    "Mode": "Cluster",
    "BootstrapEndpoints": "192.168.2.16:6379,192.168.2.33:6379,192.168.2.53:6379",
    "KeyPrefix": "auth-login",
    "DatabaseIndex": 0,
    "DefaultSessionTtlMinutes": 30,
    "SlidingExpirationEnabled": true,
    "AbsoluteLifetimeHours": 24,
    "MaxSessionsPerUser": 5,
    "ConnectTimeoutMs": 5000,
    "OperationTimeoutMs": 3000,
    "AbortOnConnectFail": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

