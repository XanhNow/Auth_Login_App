{
  "Infrastructure": {
    "Mode": "RedisVault"
  },
  "ConnectionStrings": {
    "AuthRuntimeTemplate": "Host=192.168.2.80;Port=5432;Database=authtest;Username=xanhnow_auth;Pooling=true;No Reset On Close=true;Timeout=15;Command Timeout=30"
  },
  "Vault": {
    "Address": "https://192.168.2.81:8200",
    "AuthMethod": "approle",
    "MountPath": "kv",
    "BasePath": "xanhnow/auth-login",
    "RoleIdEnvironmentVariable": "VAULT_ROLE_ID",
    "SecretIdEnvironmentVariable": "VAULT_SECRET_ID"
  },
  "Redis": {
    "Mode": "Cluster",
    "BootstrapEndpoints": "192.168.2.16:6379,192.168.2.33:6379,192.168.2.53:6379",
    "KeyPrefix": "auth-login",
    "DatabaseIndex": 0,
    "DefaultSessionTtlMinutes": 30,
    "SlidingExpirationEnabled": true,
    "AbsoluteLifetimeHours": 24,
    "MaxSessionsPerUser": 5,
    "ConnectTimeoutMs": 5000,
    "OperationTimeoutMs": 3000,
    "AbortOnConnectFail": false
  },
  "Kafka": {
    "BootstrapServers": "192.168.2.14:9092,192.168.2.31:9092,192.168.2.51:9092",
    "TopicName": "xanhnow.auth.login.events.v1",
    "ClientId": "auth-login-producer",
    "Acks": "all",
    "EnableIdempotence": true,
    "MessageKey": "user_id"
  },
  "Outbox": {
    "DispatcherId": "auth-login-outbox-dispatcher",
    "BatchSize": 50,
    "PollIntervalSeconds": 5,
    "MaxRetryCount": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
